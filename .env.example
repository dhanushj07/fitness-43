# FitFlow Environment Configuration
# GEMINI_API_KEY: Required for Gemini AI API calls
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted
APP_URL="MY_APP_URL"

# PostgreSQL Database Configuration (Prisma)
DATABASE_URL="postgresql://fitflow_admin:FitFlowSecure2026!@localhost:5432/fitflow_production?schema=public"
POSTGRES_USER="fitflow_admin"
POSTGRES_PASSWORD="FitFlowSecure2026!"
POSTGRES_DB="fitflow_production"

# Redis Cache & Session Store Configuration
REDIS_URL="redis://:fitflow_redis_secure@localhost:6379/0"
REDIS_PASSWORD="fitflow_redis_secure"

# JWT Authentication
JWT_SECRET="fitflow_jwt_super_secret_enterprise_key_2026"

# Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
VITE_GOOGLE_CLIENT_ID=""
